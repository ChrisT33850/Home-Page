<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Agents En Ligne</masterLabel>
    <description>Affiche les statuts de présence Omnichannel des agents dans les queues</description>
    
    <!-- Targets -->
    <targets>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
    </targets>
    
    <!-- Design Attributes -->
    <targetConfigs>
        <targetConfig targets="lightning__HomePage">
            <property name="title" type="String" label="Titre de la Page" description="Titre affiché en haut" default="Agents En Ligne" />
        </targetConfig>
        <targetConfig targets="lightning__AppPage">
            <property name="title" type="String" label="Titre de la Page" description="Titre affiché en haut" default="Agents En Ligne" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
